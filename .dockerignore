# Git
.git
.gitignore

# Python cache/venv
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.venv/
venv/

# Environment / secrets
.env
**/.env
admin_system/db/firebase-credentials.json
admin_system/firebase-credentials.json

# Local editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime/generated artifacts
admin_system/static/generated_ids/
admin_system/*.log
admin_system/test_output*.txt
admin_system/debug_*.py
admin_system/test_*.py

# Docs not needed in runtime image
**/README.md
**/*DEPLOYMENT*.md
**/*CHECKLIST*.md
