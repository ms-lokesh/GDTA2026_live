# Environment variables for GDTA Admin System
# Copy this to .env and update values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://127.0.0.1:5500,null

# Firebase Credentials
# Option 1: Path to JSON file (local development)
# FIREBASE_CREDENTIALS_PATH=db/firebase-credentials.json
# Option 2: JSON as environment variable (production - Render)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# Firebase Authentication (for admin/volunteer email-password login)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# If True, admin/volunteer login requires Firebase Auth success (and therefore email on accounts)
FIREBASE_AUTH_REQUIRED=False

# SMTP / Email Configuration (used by routes/admin.py)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=GDTA 2026 Team

# Gemini AI Configuration (for chatbot)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
LLM_ENABLED=True
LLM_CONFIDENCE_THRESHOLD=0.6
LLM_TIMEOUT=5

# Optional: OpenAI (if using GPT instead of Gemini)
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Grok
# GROK_API_KEY=your-grok-key-here

# Zoho Books (if payment integration is enabled)
# ZOHO_BOOKS_DATA_CENTER=in
# ZOHO_BOOKS_CLIENT_ID=your-client-id
# ZOHO_BOOKS_CLIENT_SECRET=your-client-secret
# ZOHO_BOOKS_REFRESH_TOKEN=your-refresh-token
# ZOHO_BOOKS_ACCESS_TOKEN=your-access-token-fallback
# ZOHO_BOOKS_ORGANIZATION_ID=your-org-id
# ZOHO_BOOKS_PAYMENT_LINK_TEMPLATE=your-template-id
