# Event Manager Environment Variables
# Copy this file to .env and update with your actual values

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5001

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# Firebase Configuration
# Option 1: Path to Firebase credentials JSON file
FIREBASE_CREDENTIALS_PATH=db/firebase-credentials.json

# Option 2: Firebase credentials as JSON string (for cloud deployments like Render)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://127.0.0.1:5500,null

# Cloud Platform Detection
# RENDER=true  # Set automatically on Render
# HEROKU=true  # Set automatically on Heroku

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourevent.com

# OpenAI API (if using AI features - optional)
# OPENAI_API_KEY=sk-...

# Admin Override (optional - overrides config.yaml)
# ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD=secure-password-here
# ADMIN_EMAIL=admin@yourevent.com

# Feature Flags (optional - overrides config.yaml)
# ENABLE_REGISTRATION=true
# ENABLE_CHECK_IN=true
# ENABLE_EMAIL_TEMPLATES=true
# ENABLE_ID_CARD_GENERATION=true

# Database Connection Pool (optional)
# FIRESTORE_MAX_CONNECTIONS=10
